-			configuredEntries !== undefined
-				? {
-						entries: [...configuredEntries],
-						level: ctx.extensionRoots?.configuredLevel ?? scopedRoots?.configuredLevel ?? ("user" as const),
-					}
-				: await readConfiguredExtensions(ctx);
