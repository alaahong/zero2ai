-			? scopedRoots.paths.map(raw => ({ path: resolveAgainst(raw, ctx), level: "user" }))
-			: injectedCliRoots.map(root =>
-					root.relativePath ? { ...root, path: path.resolve(ctx.cwd, root.relativePath) } : root,
-				);
