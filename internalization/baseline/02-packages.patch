+
+    async def _install_local(self, environment: BaseEnvironment) -> str:
+        if not self._tarball:
+            raise RuntimeError(
+                "ZERO2AI_BENCH_INSTALL=local requires ZERO2AI_BENCH_TARBALL (host tarball path)"
+            )
