+            command=(
+                "set -e; "
+                f"test -x {q(self._source_bun)} || {{ echo 'zero2ai source mode: bun mount missing' >&2; exit 5; }}; "
+                f"test -f {q(cli)} || {{ echo 'zero2ai source mode: repo mount missing' >&2; exit 5; }}; "
+                f"test -d {q(self._source_dir + '/node_modules/@oh-my-pi')} || "
+                "{ echo 'zero2ai source mode: linux deps mount missing' >&2; exit 5; }; "
+                f"{q(self._source_bun)} --version"
+            ),
