+        post-run parse.
+        """
+        if not path.exists():
+            return
+        with path.open(errors="replace") as fh:
+            for line in fh:
+                event = _loads(line)
+                if not event or event.get("type") != "message_end":
+                    continue
+                message = event.get("message")
+                if isinstance(message, dict) and message.get("role") == "assistant":
+                    acc.add(message.get("usage"))
