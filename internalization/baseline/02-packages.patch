-		const content = await readFile(path.join(scopeDir, filename));
-		if (content === null) continue;
-		let parsed: unknown;
-		try {
-			parsed = YAML.parse(content);
-		} catch {
-			return { exists: true, entries: null };
-		}
-		if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
-			return { exists: true, entries: null };
-		}
