+# ② 指向内网网关（客户端）
+export ZERO2AI_CONFIG_DIR=/opt/corp/zero2ai
+export ZERO2AI_CODING_AGENT_DIR=/opt/corp/zero2ai/agent
+export LITELLM_BASE_URL=https://llm-gw.corp.local/v1
