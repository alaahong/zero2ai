-OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.corp.local:4318
-OTEL_SERVICE_NAME=zero2ai
-ZERO2AI_AUTO_QA=0
-ZERO2AI_BROWSER_RELAY=0
-# 明确不要设置：OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT、ZERO2AI_REQ_DEBUG
