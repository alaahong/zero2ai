-            None,
-        )
-        if tool is None:
-            self._send_notification(
-                {
-                    "type": "host_tool_result",
-                    "id": request_id,
-                    "result": {
-                        "content": [
-                            {
-                                "type": "text",
-                                "text": f'Host tool "{tool_name}" is not registered',
-                            }
-                        ],
-                        "details": {},
-                    },
-                    "isError": True,
-                }
-            )
-            return
