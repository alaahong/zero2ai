+            ExtensionUiMethod,
+            _require_literal(
+                payload.get("method"),
+                _EXTENSION_UI_METHOD_VALUES,
+                field="extension_ui_request.method",
+            ),
+        ),
+        title=_optional_str(payload, "title"),
